@article{RP2025,
  title={Racial Disparities in Political Representation: Evidence from Brazil, 2006-2022},
  author={Pérez Cervera, Laura},
  year={2025},
  abstract={This paper examines the determinants of racial political representation in Brazil from 2006 to 2022, focusing on supply-side factors. To address data limitations on the disclosure of candidates' race, I train an Automated Machine Learning model for image classification applied to over 1.5 million candidate photos. The analysis reveals that non-White candidates, although numerically superior, face significant electoral disadvantages compared to White candidates. This disparity persists across all election levels and is influenced by differential party endorsements, particularly campaign funding. I also identify inequalities in education and wealth among candidates, likely reflecting the structural racial inequalities in the country. Despite recent improvements in non-White representation, pronounced disparities remain, especially in higher political offices.}
}
