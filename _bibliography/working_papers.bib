@article{AR2025,
  title={Affirming a Racial Divide? The Political Consequences of Affirmative Action in Brazil},
  author={Pérez Cervera, Laura},
  year={2025},
  abstract={Affirmative action policies are designed to increase opportunities for underrepresented groups. This paper explores a potential unintended effect: whether by emphasizing group identity in resource allocation, these policies can polarize voters along identity lines. I investigate this by focusing on the implementation of the first nationwide racial affirmative action policy in Brazil, the Law of Quotas, which mandated that half of all admission seats in public federal universities be reserved for historically underrepresented groups, including non-White students. To assess the local effects of the policy, I construct a municipality-level exposure measure based on pre-policy enrolment patterns and the expansion of reserved seats across federal universities. Combining geographically granular voting data, electorates' demographics, and an automated machine-learning model trained to approximate candidates' racial identity based on official photographs, I find that the reform increased support for ideologically polarized Black candidates in Brazilian legislative elections. This effect emerged as greater support for left-wing Black candidates among the non-White electorate and a rise in support for Black conservative candidates among White voters. I argue that this polarization was driven by Black candidates becoming more vocal on racial issues, while adopting opposing positions on these topics across ideological lines.},
  pdf={PerezCervera_(2025)_AA_and_Racial_Voting_JMP.pdf}
}
@article{IG2025,
  title={High-Speed Internet and Government Spending: Evidence from the United States},
  author={Pérez Cervera, Laura},
  journal={Submitted},
  year={2026},
  abstract={This paper studies how broadband Internet diffusion affects government responsiveness by examining the allocation of U.S. federal spending across municipalities between 1999 and 2010. Using proximity to the Interstate Highway System as a cost-based instrument for broadband deployment, I find that broadband expansion increases discretionary spending, the component most responsive to political incentives, while leaving mandatory spending unaffected. Broadband diffusion also increases campaign contributions in presidential and congressional elections, partly driven by the entry of new donors. These findings suggest that broadband diffusion strengthens electoral incentives and shifts public spending toward domains where elected officials retain allocation discretion.},
  pdf={PerezCervera_(2026)_Broadband_GovSpending.pdf}
}
